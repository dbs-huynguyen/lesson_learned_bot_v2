{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    "."
  ],
  "graphs": {
    "chat": "./src/agent/chat_graph.py:graph",
    "list_files": "./src/agent/list_files_graph.py:graph"
  },
  "env": ".env",
  "image_distro": "wolfi",
  "checkpointer": {
    "serde": {
      "allowed_msgpack_modules": [
        [
          "src.agent.common",
          "KeywordFilter"
        ],
        [
          "src.agent.common",
          "DateFilter"
        ],
        [
          "qdrant_client.http.models.models",
          "Filter"
        ]
      ]
    }
  }
}